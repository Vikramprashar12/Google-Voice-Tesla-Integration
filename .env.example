# Tesla Developer app credentials (developer.tesla.com)
TESLA_CLIENT_ID=your-client-id
TESLA_CLIENT_SECRET=your-client-secret

# Must exactly match a redirect URI registered on your Tesla developer app.
TESLA_REDIRECT_URI=https://localhost:8585/callback

# Space-separated OAuth scopes you registered for.
TESLA_SCOPES=openid offline_access vehicle_device_data vehicle_cmds vehicle_charging_cmds vehicle_location

# Fleet API region base URL. Discovered automatically after login and cached,
# but you can set it explicitly to skip the discovery call.
#   NA/APAC: https://fleet-api.prd.na.vehicle-command.tesla.com
#   EU:      https://fleet-api.prd.eu.vehicle-command.tesla.com
#   CN:      https://fleet-api.prd.cn.vehicle-command.tesla.cn
TESLA_FLEET_API_BASE=https://fleet-api.prd.na.vehicle-command.tesla.com

# Where OAuth tokens are cached between runs.
TESLA_TOKEN_FILE=.tesla_tokens.json

# --- Command signing (tesla-http-proxy) ---
# All vehicle *commands* (lock, honk, climate, charging, etc.) on 2021+ vehicles
# must be signed and are sent through Tesla's local http proxy, not the Fleet
# API directly. Read-only calls (vehicle list, vehicle_data, wake_up) do NOT
# go through the proxy. See README.md for how to build/run the proxy.
TESLA_PROXY_BASE=https://localhost:4443
TESLA_PROXY_VERIFY_SSL=false
